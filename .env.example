# Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# PostgreSQL Database (External)
# ===========================================
POSTGRES_SERVER=your-postgres-server.example.com
POSTGRES_PORT=5432
POSTGRES_DB=kurumsalindirim
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# ===========================================
# Keycloak Authentication (External)
# ===========================================
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=coupon-realm
KEYCLOAK_CLIENT_ID=coupon-backend
KEYCLOAK_CLIENT_SECRET=your_client_secret
KEYCLOAK_FRONTEND_CLIENT_ID=coupon-frontend

# ===========================================
# Application Settings
# ===========================================
SECRET_KEY=your-secret-key-min-32-chars-long
ENVIRONMENT=production
DOMAIN=kurumsalindirim.mfa.gov.tr
FRONTEND_HOST=https://kurumsalindirim.mfa.gov.tr
BACKEND_CORS_ORIGINS=https://kurumsalindirim.mfa.gov.tr

# ===========================================
# Initial Admin User
# ===========================================
FIRST_SUPERUSER=admin@kurumsalindirim.mfa.gov.tr
FIRST_SUPERUSER_PASSWORD=your_secure_password

# ===========================================
# Frontend Build Arguments (used during Docker build)
# ===========================================
VITE_API_URL=https://api.kurumsalindirim.mfa.gov.tr
